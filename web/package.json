    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "openapi-typescript": "^7.0.0",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
